# Leave APP_PORT empty on platforms that inject PORT (Render/Railway/etc.).
APP_PORT=8080
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=cafe_mvp
# At least 32 random characters each. Development generates missing keys in .env.local.
JWT_SECRET=
JWT_REFRESH_SECRET=
TABLE_TOKEN_SECRET=
FRONTEND_URL=http://localhost:5173,https://smart-kaffe.vercel.app
ORDER_CONFIRMATION_TIMEOUT_MINUTES=5
# Optional explicit DNS resolver, only if your system cannot resolve Atlas SRV records.
MONGODB_DNS_SERVER=
ADMIN_EMAIL=admin@tamak.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
